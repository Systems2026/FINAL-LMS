DB_HOST=localhost
DB_PORT=3306
# Local development only; use a dedicated least-privilege user in deployments.
DB_USER=root
DB_PASSWORD=
# DB_NAME selects the database. Production remains on snhs_lms until migration
# is explicitly approved. To run the normalized API locally, set both values
# explicitly after copying the normalized schema into lms_clean.
DB_NAME=snhs_lms
# Supported profiles: legacy, normalized_v1. Normalized mode verifies the
# schema marker and required tables before serving any API routes.
DB_SCHEMA_PROFILE=legacy
PORT=4000
ALLOW_JSON_FALLBACK=false
SNSHS_DATA_PATH=

# Optional Vite/Figma Make hosting settings.
FIGMA_PUBLIC_URL=
FIGMA_DEV_SERVER_HOST=

# Optional, one-time account creation when the configured store has no users.
# Remove these values from .env after the first administrator has been created.
BOOTSTRAP_ADMIN_ID=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
